# FastCheckAI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# OpenAI API Configuration
# =============================================================================

OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# LLM Model Configuration
# =============================================================================

MODEL=gpt-4o
TEMPERATURE=0.3
MAX_TOKENS=4000

# =============================================================================
# Pipeline Thresholds
# =============================================================================

FUZZY_MATCH_THRESHOLD=0.8
SEMANTIC_CONFIDENCE_THRESHOLD=0.7
ALIGNMENT_CONFIDENCE_THRESHOLD=0.8

# =============================================================================
# Performance Limits
# =============================================================================

MAX_PDF_SIZE_MB=25
MAX_PROCESSING_TIME_SECONDS=180

# =============================================================================
# OCR Configuration (Feature 3)
# =============================================================================

# Enable automatic OCR fallback for corrupted PDFs (requires Tesseract)
ENABLE_OCR=true

# Corruption detection threshold (0.0 to 1.0)
# Higher values = less sensitive to corruption
# Default: 0.30 (30% special characters triggers OCR)
OCR_CORRUPTION_THRESHOLD=0.30

# OCR rendering resolution in DPI
# Higher values = better quality but slower
# Recommended: 300 (standard), 600 (high quality), 150 (fast)
OCR_DPI=300

# =============================================================================
# Logging Configuration
# =============================================================================

LOG_LEVEL=INFO
